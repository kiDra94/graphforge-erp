# Copy to .env and adjust. Never commit the real .env.

# --- Neo4j -------------------------------------------------------------------
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me

# Optional, shown with their defaults.
# NEO4J_MAX_CONNECTION_POOL_SIZE=50
# NEO4J_CONNECTION_ACQUISITION_TIMEOUT=10
# NEO4J_CONNECTION_TIMEOUT=10
# NEO4J_MAX_CONNECTION_LIFETIME=3600

# --- Authentication ----------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-this-value-signs-every-token
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=480

# --- Logging -----------------------------------------------------------------
# LOG_LEVEL=INFO
# LOG_FILE=logs/app.log
# DEBUG turns on diagnose in the console sink, which prints local variables into the
# log. Never enable it where the logs are kept.
# DEBUG=false
