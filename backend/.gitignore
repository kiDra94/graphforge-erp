# Environment variables and secrets
#
# `.env` holds the database password and the JWT signing key. The example file is the one
# that belongs in the repository, and the exception below is what keeps it there.
.env
.env.*
!.env.example
*.pem
*.key

# Virtual environments
.venv/
venv/
env/

# Python bytecode and caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Coverage
.coverage
.coverage.*
htmlcov/

# Runtime output — the log sink writes here (see core/logging_setup.py)
logs/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
