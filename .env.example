# Copy to .env for `docker compose`. Never commit the real .env.
#
# Not to be confused with backend/.env.example: that one configures the backend when it
# runs directly through `uv run poe dev`. This one configures the compose stack, and the
# database URI is set in docker-compose.yml rather than here — inside the compose network
# the database answers under its service name.

# --- Database ----------------------------------------------------------------
# Used by both services: neo4j takes it as its password, the backend to sign in.
NEO4J_PASSWORD=change-me

# --- Authentication ----------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-this-value-signs-every-token

# --- Logging -----------------------------------------------------------------
# LOG_LEVEL=INFO
